{
  "name": "trollysix-client",
  "version": "1.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:open": "ng serve -o",
    "build": "ng build",
    "build:stats": "ng build --configuration production --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "cypress run --config-file cypress.config.ts",
    "e2e:open": "cypress open --config-file cypress.config.ts",
    "start:ssr": "node dist/trollysix-client/server/server.mjs",
    "start:ssr:e2e": "NG_ALLOWED_HOSTS=localhost,127.0.0.1 node dist/trollysix-client/server/server.mjs",
    "serve:ssr:trollysix-client": "node dist/trollysix-client/server/server.mjs",
    "lint": "ng lint",
    "prepare": "husky || true"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-browser-dynamic": "^21.2.14",
    "@angular/platform-server": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@angular/service-worker": "^21.2.14",
    "@angular/ssr": "^21.2.13",
    "@ngrx/effects": "^21.1.0",
    "@ngrx/entity": "^21.1.0",
    "@ngrx/router-store": "^21.1.0",
    "@ngrx/store": "^21.1.0",
    "@ngrx/store-devtools": "^21.1.0",
    "express": "^5.2.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.4.0",
    "@angular/build": "^21.2.13",
    "@angular/cli": "^21.2.13",
    "@angular/compiler-cli": "^21.2.14",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/angular": "^19.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.41",
    "angular-eslint": "21.4.0",
    "commit-and-tag-version": "^12.7.3",
    "commitlint": "^19.8.1",
    "cypress": "15.16.0",
    "eslint": "^9.39.4",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^8.0.3",
    "jsdom": "^27.4.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.40.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.7"
  },
  "lint-staged": {
    "*.{html,scss,css,json}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  }
}
