    "@testing-library/jest-dom": "^6.6.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "21.1.0",
    "commit-and-tag-version": "^12.5.2",
    "commitlint": "^19.8.1",
    "cypress": "latest",
    "eslint": "^9.33.0",
    "husky": "^8.0.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.1.13",
