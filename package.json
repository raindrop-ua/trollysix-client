{
  "name": "trollysix-client",
  "version": "1.7.0",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:open": "ng serve -o",
    "build": "ng build",
    "build:stats": "ng build --configuration production --stats-json",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "e2e": "cypress run --config-file cypress.config.ts",
    "e2e:open": "cypress open --config-file cypress.config.ts",
    "start:ssr": "node dist/trollysix-client/server/server.mjs",
    "start:ssr:e2e": "NG_ALLOWED_HOSTS=localhost,127.0.0.1 node dist/trollysix-client/server/server.mjs",
    "serve:ssr:trollysix-client": "node dist/trollysix-client/server/server.mjs",
    "lint": "ng lint",
    "prepare": "husky || true"
  },
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "dependencies": {
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-server": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@angular/service-worker": "^22.2.3",
    "@angular/ssr": "^22.2.4",
    "@date-fns/tz": "^1.5.0",
    "@ngrx/effects": "^22.0.1",
    "@ngrx/entity": "^22.0.1",
    "@ngrx/router-store": "^22.0.1",
    "@ngrx/store": "^22.0.1",
    "@ngrx/store-devtools": "^22.0.1",
    "date-fns": "^4.4.0",
    "express": "^5.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.6.0",
    "@angular/build": "^22.2.4",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/language-server": "0.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/angular": "^19.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "angular-eslint": "22.6.0",
    "cypress": "16.2.0",
    "eslint": "^10.13.0",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{html,scss,css,json}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  }
}
